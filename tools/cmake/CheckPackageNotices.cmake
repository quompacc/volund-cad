# L04: checks an installed package against packaging/Components.cmake and its MANIFEST.txt.
#
#   cmake -DVOELUND_PREFIX=<prefix> -DVOELUND_COMPONENTS=<Components.cmake>
#         -DVOELUND_COMPONENT_VERSIONS=<component-versions.cmake> -P CheckPackageNotices.cmake
#
# Fails, naming the file, when a file belongs to no component, a shipped or embedded component
# lacks one of its notices, or the manifest and the package differ.
cmake_policy(SET CMP0007 NEW)
include("${CMAKE_CURRENT_LIST_DIR}/PackageComponents.cmake")
if(NOT IS_DIRECTORY "${VOELUND_PREFIX}")
    message(FATAL_ERROR "VOELUND_PREFIX must be the installed package root")
endif()
# A relative prefix (cmake --install --prefix <dir>) is relative to the working directory.
file(REAL_PATH "${VOELUND_PREFIX}" VOELUND_PREFIX)
set(problems "")

voelund_package_files("${VOELUND_PREFIX}" files)
set(present "")
foreach(path IN LISTS files)
    voelund_component_of("${path}" component)
    if(component STREQUAL "")
        list(APPEND problems "belongs to no component: ${path}")
    else()
        list(APPEND present "${component}")
    endif()
endforeach()

get_property(components GLOBAL PROPERTY voelund_components)
foreach(name IN LISTS components)
    get_property(embedded GLOBAL PROPERTY "voelund_component_${name}_embedded")
    if(NOT embedded AND NOT name IN_LIST present)
        continue()
    endif()
    get_property(notices GLOBAL PROPERTY "voelund_component_${name}_notices")
    foreach(notice IN LISTS notices)
        if(NOT EXISTS "${VOELUND_PREFIX}/${notice}")
            list(APPEND problems "notice missing for ${name}: ${notice}")
        endif()
    endforeach()
endforeach()

set(manifest "${VOELUND_PREFIX}/MANIFEST.txt")
if(NOT EXISTS "${manifest}")
    list(APPEND problems "MANIFEST.txt missing")
else()
    file(STRINGS "${manifest}" lines ENCODING UTF-8 REGEX "^file\t")
    set(listed "")
    foreach(line IN LISTS lines)
        string(REPLACE "\t" ";" fields "${line}")
        list(GET fields 1 hash)
        list(GET fields 3 path)
        list(APPEND listed "${path}")
        if(NOT EXISTS "${VOELUND_PREFIX}/${path}")
            list(APPEND problems "in the manifest, not in the package: ${path}")
            continue()
        endif()
        file(SHA256 "${VOELUND_PREFIX}/${path}" actual)
        if(NOT actual STREQUAL hash)
            list(APPEND problems "differs from the manifest: ${path}")
        endif()
    endforeach()
    foreach(path IN LISTS files)
        if(NOT path IN_LIST listed)
            list(APPEND problems "in the package, not in the manifest: ${path}")
        endif()
    endforeach()
endif()

if(problems)
    list(JOIN problems "\n  " text)
    message(FATAL_ERROR "Package notices incomplete:\n  ${text}")
endif()
list(LENGTH files count)
message(STATUS "Package notices complete: ${count} files, each with its component and notices")
