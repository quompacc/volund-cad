# Compares a clang-tidy report (readability-function-size and voelund-cyclomatic-complexity)
# with the visible exception list (user decision 2026-10-17, A04):
#   - a function over a limit that the list does not name fails ("new");
#   - a listed function whose value rose fails ("rose");
#   - a listed function that is now within the limit, renamed or gone fails ("stale"), so the
#     list only ever shrinks with the code.
#
#   -DVOELUND_SOURCE_ROOT=<repository>  -DVOELUND_TIDY_REPORT=<clang-tidy output>
#   -DVOELUND_ANALYSED_FILES=<count>    -DVOELUND_FUNCTION_LIMITS=<list>
#   -DVOELUND_CURRENT_LIMITS=<file>     optional: writes the measured state in list format
#
# Rules and values: lines (function lines), parameters (count), nesting (sites deeper than 4),
# cyclomatic (McCabe value). Keys are rule | repository-relative path | function name.
cmake_policy(SET CMP0007 NEW)
foreach(required VOELUND_SOURCE_ROOT VOELUND_TIDY_REPORT VOELUND_ANALYSED_FILES VOELUND_FUNCTION_LIMITS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required; the analysis must not be skipped")
    endif()
endforeach()
if(NOT EXISTS "${VOELUND_TIDY_REPORT}")
    message(FATAL_ERROR "No analysis report: ${VOELUND_TIDY_REPORT}")
endif()
if(NOT VOELUND_ANALYSED_FILES GREATER 0)
    message(FATAL_ERROR "No translation unit was analysed")
endif()
if(NOT EXISTS "${VOELUND_FUNCTION_LIMITS}")
    message(FATAL_ERROR "No exception list: ${VOELUND_FUNCTION_LIMITS}")
endif()

set(measured_keys "")
# A function, not a macro: macro arguments would re-evaluate backslashes in paths.
function(record rule path name value)
    file(TO_CMAKE_PATH "${path}" path)
    file(RELATIVE_PATH relative "${VOELUND_SOURCE_ROOT}" "${path}")
    set(key "${rule} | ${relative} | ${name}")
    string(MD5 hash "${key}")
    if(NOT DEFINED measured_${hash})
        list(APPEND measured_keys "${key}")
        set(measured_keys "${measured_keys}" PARENT_SCOPE)
        set(measured_${hash} "${value}" PARENT_SCOPE)
    elseif(value GREATER measured_${hash})
        set(measured_${hash} "${value}" PARENT_SCOPE)
    endif()
endfunction()

# One function's notes follow its readability-function-size warning; a header seen from many
# translation units repeats identically and keeps the highest value.
file(STRINGS "${VOELUND_TIDY_REPORT}" report_lines REGEX ": (warning|error|note): ")
set(errors "")
set(function_path "")
set(function_name "")
set(nesting 0)
macro(flush_nesting)
    if(nesting GREATER 0)
        record(nesting "${function_path}" "${function_name}" ${nesting})
    endif()
    set(nesting 0)
endmacro()
foreach(line IN LISTS report_lines)
    if(line MATCHES "^(.+):[0-9]+:[0-9]+: warning: function '([^']+)' exceeds recommended size/complexity thresholds")
        flush_nesting()
        set(function_path "${CMAKE_MATCH_1}")
        set(function_name "${CMAKE_MATCH_2}")
    elseif(line MATCHES ": note: ([0-9]+) lines including whitespace and comments \\(threshold")
        record(lines "${function_path}" "${function_name}" ${CMAKE_MATCH_1})
    elseif(line MATCHES ": note: ([0-9]+) parameters \\(threshold")
        record(parameters "${function_path}" "${function_name}" ${CMAKE_MATCH_1})
    elseif(line MATCHES ": note: nesting level [0-9]+ starts here")
        math(EXPR nesting "${nesting} + 1")
    elseif(line MATCHES "^(.+):[0-9]+:[0-9]+: warning: cyclomatic complexity ([0-9]+) of '(.+)' exceeds limit")
        flush_nesting()
        set(function_path "")
        record(cyclomatic "${CMAKE_MATCH_1}" "${CMAKE_MATCH_3}" ${CMAKE_MATCH_2})
    elseif(line MATCHES ": (warning: no CFG for|error: )")
        list(APPEND errors "${line}")
    endif()
endforeach()
flush_nesting()
if(errors)
    list(JOIN errors "\n  " text)
    message(FATAL_ERROR "Analysis errors (not limit violations):\n  ${text}")
endif()

# The list: "rule | path | function | value | reason", '#' starts a comment.
file(STRINGS "${VOELUND_FUNCTION_LIMITS}" list_lines ENCODING UTF-8)
set(listed_keys "")
foreach(line IN LISTS list_lines)
    if(line MATCHES "^[ \t]*(#|$)")
        continue()
    endif()
    if(NOT line MATCHES "^(lines|parameters|nesting|cyclomatic) \\| ([^|]+) \\| ([^|]+) \\| ([0-9]+) \\| (.+)$")
        message(FATAL_ERROR "Malformed exception (rule | path | function | value | reason): ${line}")
    endif()
    set(key "${CMAKE_MATCH_1} | ${CMAKE_MATCH_2} | ${CMAKE_MATCH_3}")
    string(MD5 hash "${key}")
    if(DEFINED listed_${hash})
        message(FATAL_ERROR "Exception listed twice: ${key}")
    endif()
    list(APPEND listed_keys "${key}")
    set(listed_${hash} "${CMAKE_MATCH_4}")
    set(reason_${hash} "${CMAKE_MATCH_5}")
endforeach()

set(problems "")
set(current "")
foreach(key IN LISTS measured_keys)
    string(MD5 hash "${key}")
    set(value "${measured_${hash}}")
    if(NOT DEFINED listed_${hash})
        list(APPEND problems "new: ${key} = ${value}")
        set(reason "neu")
    else()
        set(reason "${reason_${hash}}")
        if(value GREATER listed_${hash})
            list(APPEND problems "rose: ${key} from ${listed_${hash}} to ${value}")
        endif()
    endif()
    list(APPEND current "${key} | ${value} | ${reason}")
endforeach()
foreach(key IN LISTS listed_keys)
    string(MD5 hash "${key}")
    if(NOT DEFINED measured_${hash})
        list(APPEND problems "stale: ${key} is within the limit, renamed or gone; remove it from the list")
    endif()
endforeach()

list(LENGTH measured_keys measured_count)
list(LENGTH listed_keys listed_count)
if(DEFINED VOELUND_CURRENT_LIMITS AND NOT VOELUND_CURRENT_LIMITS STREQUAL "")
    list(SORT current)
    list(JOIN current "\n" text)
    file(WRITE "${VOELUND_CURRENT_LIMITS}" "${text}\n")
endif()
if(problems)
    list(SORT problems)
    list(JOIN problems "\n  " text)
    message(FATAL_ERROR "Function limits differ from ${VOELUND_FUNCTION_LIMITS}:\n  ${text}")
endif()
message(STATUS "Function limits: ${VOELUND_ANALYSED_FILES} units, ${measured_count} listed violations, none new or higher")
