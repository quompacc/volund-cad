# L03: writes voelund/BuildInfo.hpp with the product version, the source revision and the build
# type. Runs on every build; the file is rewritten only when its content changes, so an
# unchanged revision rebuilds nothing.
#
#   cmake -DVOELUND_SOURCE_ROOT=... -DVOELUND_OUTPUT=... -DVOELUND_VERSION=... \
#         -DVOELUND_BUILD_TYPE=... -P tools/cmake/WriteBuildInfo.cmake
foreach(required VOELUND_SOURCE_ROOT VOELUND_OUTPUT VOELUND_VERSION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

set(revision "unknown")
find_program(git_executable git)
if(git_executable)
    execute_process(
        COMMAND "${git_executable}" -c safe.directory=* describe --always --dirty --abbrev=7
        WORKING_DIRECTORY "${VOELUND_SOURCE_ROOT}"
        RESULT_VARIABLE git_result OUTPUT_VARIABLE git_output ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(git_result EQUAL 0 AND NOT git_output STREQUAL "")
        set(revision "${git_output}")
    endif()
endif()
if(NOT DEFINED VOELUND_BUILD_TYPE OR VOELUND_BUILD_TYPE STREQUAL "")
    set(VOELUND_BUILD_TYPE "unspecified")
endif()

set(content "#pragma once
// Generated by tools/cmake/WriteBuildInfo.cmake (L03); do not edit.
namespace voelund::build {
inline constexpr const char* version = \"${VOELUND_VERSION}\";
inline constexpr const char* revision = \"${revision}\";
inline constexpr const char* buildType = \"${VOELUND_BUILD_TYPE}\";
} // namespace voelund::build
")
set(previous "")
if(EXISTS "${VOELUND_OUTPUT}")
    file(READ "${VOELUND_OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${VOELUND_OUTPUT}" "${content}")
endif()
