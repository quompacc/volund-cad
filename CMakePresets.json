{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VOELUND_BUILD_DESKTOP": "ON",
        "VOELUND_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC Qt OpenGL product path",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-voelund",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.tools/qt",
        "VOELUND_VIEWPORT_BACKEND": "qt-opengl",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Qt OpenGL product path, Release",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-native-diagnostic",
      "displayName": "Windows MSVC native viewport diagnostic path",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VOELUND_VIEWPORT_BACKEND": "native",
        "VCPKG_MANIFEST_MODE": "OFF"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-voelund",
        "VOELUND_BUILD_DESKTOP": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
      }
    },
    {
      "name": "linux-desktop",
      "displayName": "Linux GCC Native Wayland Desktop with lean OCCT",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VOELUND_VIEWPORT_BACKEND": "qt-opengl",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.tools/occt-linux/install"
      }
    },
    {
      "name": "linux-desktop-release",
      "displayName": "Linux GCC Native Wayland Desktop with lean OCCT, Release",
      "inherits": "linux-desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "freebsd-clang",
      "displayName": "FreeBSD Clang Native Wayland Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VOELUND_VIEWPORT_BACKEND": "qt-opengl"
      }
    },
    {
      "name": "freebsd-clang-lean-occt",
      "displayName": "FreeBSD Clang Native Wayland with lean OCCT",
      "inherits": "freebsd-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.tools/occt-freebsd/install"
      }
    },
    {
      "name": "freebsd-clang-lean-occt-release",
      "displayName": "FreeBSD Clang Native Wayland with lean OCCT, Release",
      "inherits": "freebsd-clang-lean-occt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-native-diagnostic",
      "configurePreset": "windows-msvc-native-diagnostic"
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-desktop",
      "configurePreset": "linux-desktop"
    },
    {
      "name": "linux-desktop-release",
      "configurePreset": "linux-desktop-release"
    },
    {
      "name": "freebsd-clang",
      "configurePreset": "freebsd-clang"
    },
    {
      "name": "freebsd-clang-lean-occt",
      "configurePreset": "freebsd-clang-lean-occt"
    },
    {
      "name": "freebsd-clang-lean-occt-release",
      "configurePreset": "freebsd-clang-lean-occt-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-native-diagnostic",
      "configurePreset": "windows-msvc-native-diagnostic",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-desktop",
      "configurePreset": "linux-desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-desktop-release",
      "configurePreset": "linux-desktop-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "freebsd-clang",
      "configurePreset": "freebsd-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "freebsd-clang-lean-occt",
      "configurePreset": "freebsd-clang-lean-occt",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "freebsd-clang-lean-occt-release",
      "configurePreset": "freebsd-clang-lean-occt-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
